#!/bin/bash
# CoMaps launcher for Ubuntu Touch.
# Sets up the bundled Qt6 libraries, the Wayland platform plugin, the UI scale
# and the read-only/writable data paths, then execs the real binary.
set -e

# NOTE: Under the UT 24.04 AppArmor profile (policy 2404.x) a confined app may
# not exec /usr/bin/* tools (dirname, awk, mkdir, ...). Only bash builtins and
# binaries inside the click dir are allowed. Keep this script builtin-only.
HERE="${BASH_SOURCE[0]%/*}"
[ "$HERE" = "${BASH_SOURCE[0]}" ] && HERE="$PWD"

export LD_LIBRARY_PATH="$HERE/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$HERE/lib/plugins"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
# Lomiri draws the window frame; Qt must not add its own decorations.
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1

# Scaling: Lomiri does NOT pass its scale to Qt6 over Wayland (measured on UT
# 24.04: devicePixelRatio 1, CoMaps "Visual scale = 1"). It exports GRID_UNIT_PX
# (8 on a desktop, ~18-27 on a phone), so scale the UI by GRID_UNIT_PX / 8 to
# match native apps. This also makes CoMaps pick the hi-dpi map resources.
# Optional fine tuning without reinstalling: a multiplier such as 0.9 or 1.15
# in ~/.config/ut-comaps/scale (1.0 = native app size).
# Everything in hundredths with bash integer arithmetic (no awk/bc allowed).
if [ -z "${QT_SCALE_FACTOR:-}" ] && [ -n "${GRID_UNIT_PX:-}" ]; then
    g="${GRID_UNIT_PX%%.*}"
    if [[ "$g" =~ ^[0-9]+$ ]] && [ "$g" -gt 0 ]; then
        c=$(( g * 25 / 2 ))                     # g / 8 * 100
        SCALE_FILE="$HOME/.config/ut-comaps/scale"
        if [ -r "$SCALE_FILE" ]; then
            read -r s < "$SCALE_FILE" || true
            if [[ "${s:-}" =~ ^([0-9]+)(\.([0-9]{1,2}))?$ ]]; then
                f="${BASH_REMATCH[3]:-0}"; [ "${#f}" -eq 1 ] && f="${f}0"
                m=$(( 10#${BASH_REMATCH[1]} * 100 + 10#$f ))   # multiplier * 100
                [ "$m" -gt 0 ] && c=$(( c * m / 100 ))
            fi
        fi
        printf -v QT_SCALE_FACTOR '%d.%02d' $(( c / 100 )) $(( c % 100 ))
        export QT_SCALE_FACTOR
    fi
fi

# Confined apps may only write below ~/.local/share/<click name> (and .cache,
# .config). The click itself is read-only: it holds the resources.
PKG="ut-comaps"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/$PKG"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
# CoMaps puts its settings in QStandardPaths::GenericConfigLocation + "/CoMaps"
# (= $XDG_CONFIG_HOME/CoMaps). AppArmor only allows ~/.config/<click name>/,
# so point XDG_CONFIG_HOME there -> ~/.config/ut-comaps/CoMaps.
# (The Lomiri theme file is read via $HOME, so this does not affect it.)
CONF="$HOME/.config/$PKG"
export XDG_CONFIG_HOME="$CONF"
# Set CoMaps' own dirs before Platform() guesses defaults (~/.local/share/CoMaps).
export MWM_WRITABLE_DIR="$DATA/"
export MWM_RESOURCES_DIR="$HERE/data/"
# bash has no mkdir builtin and /usr/bin/mkdir is denied, so package.sh bundles
# a copy inside the click (exec from the click dir is allowed).
if [ ! -d "$DATA" ] || [ ! -d "$CONF" ] || [ ! -d "$XDG_CACHE_HOME/$PKG" ]; then
    "$HERE/bin/mkdir" -p "$DATA" "$CONF" "$XDG_CACHE_HOME/$PKG" || true
fi

exec "$HERE/comaps.bin" -resources_path "$HERE/data/" -data_path "$DATA/" "$@"
