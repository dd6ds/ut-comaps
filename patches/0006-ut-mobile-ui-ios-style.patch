+MapMode const kModes[] = {MapMode::Walking, MapMode::Cycling, MapMode::Driving, MapMode::PublicTransport};
+char const * const kModeIcons[] = {"walking", "cycling", "driving", "publictransport"};
+int constexpr kModeCell = 48;
