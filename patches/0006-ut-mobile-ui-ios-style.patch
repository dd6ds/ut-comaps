+  if (isDown())
+  {
+    p.setPen(Qt::NoPen);
+    p.setBrush(st.panelPressed);
+    p.drawRoundedRect(QRectF(rect()).adjusted(4, 1, -4, -1), 10, 10);
+  }
+  QColor const iconColor = (isCheckable() && isChecked()) ? st.accent : st.text;
+  PaintIcon(p, m_icon, QRectF(16, (height() - 22) / 2.0, 22, 22), iconColor);
+  p.setPen(st.text);
+  p.setFont(font());
+  int const right = isCheckable() ? 40 : 12;
+  p.drawText(QRect(54, 0, width() - 54 - right, height()), Qt::AlignVCenter | Qt::AlignLeft | Qt::TextWordWrap,
+             text());
+  if (isCheckable() && isChecked())
+    PaintIcon(p, "check", QRectF(width() - 34, (height() - 20) / 2.0, 20, 20), st.accent);
+}
