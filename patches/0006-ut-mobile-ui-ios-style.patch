+
+QLabel * RowLabel(QString const & text, int px, QColor const & color, bool bold = false)
+{
+  auto * label = new QLabel(text);
+  label->setTextFormat(Qt::RichText);
+  label->setWordWrap(true);
+  QFont f = label->font();
+  f.setPixelSize(px);
+  f.setBold(bold);
+  label->setFont(f);
+  label->setStyleSheet(QString("color: %1; background: transparent;").arg(color.name()));
+  return label;
+}
+
+// One list row: icon, title, up to two lines below, distance on the right.
+QWidget * MakeRow(QString const & icon, QString const & titleHtml, QString const & line1, QString const & line2,
+                  QString const & right, bool boldTitle)
+{
+  auto const & st = CurrentStyle();
+  auto * row = new QWidget();
+  row->setAttribute(Qt::WA_TransparentForMouseEvents);
+  auto * h = new QHBoxLayout(row);
+  h->setContentsMargins(16, 10, 16, 10);
+  h->setSpacing(14);
+  auto * iv = new mobile::IconView(icon, 22);
+  iv->SetColor(icon == "circle" ? st.locationBlue : (boldTitle ? st.text : st.secondary));
+  h->addWidget(iv, 0, boldTitle ? Qt::AlignTop : Qt::AlignVCenter);
+  auto * v = new QVBoxLayout();
+  v->setSpacing(1);
+  v->addWidget(RowLabel(titleHtml, boldTitle ? 18 : 17, st.text, boldTitle));
+  if (!line1.isEmpty())
+    v->addWidget(RowLabel(line1.toHtmlEscaped(), 14, st.text));
+  if (!line2.isEmpty())
+    v->addWidget(RowLabel(line2.toHtmlEscaped(), 14, st.secondary));
+  h->addLayout(v, 1);
+  if (!right.isEmpty())
+  {
+    QLabel * r = RowLabel(right.toHtmlEscaped(), 14, st.secondary);
+    r->setWordWrap(false);
+    h->addWidget(r, 0, Qt::AlignBottom);
+  }
+  return row;
+}
+
+// Row height for the list's width (wrapped labels).
+int RowHeight(QWidget * row, int width, int minimum)
+{
+  int const h = row->hasHeightForWidth() ? row->heightForWidth(width) : row->sizeHint().height();
+  return std::max(h, minimum);
+}
+
+QIcon ClearIcon()
+{
+  auto const & st = CurrentStyle();
+  QPixmap pm(64, 64);
+  pm.fill(Qt::transparent);
+  QPainter p(&pm);
+  p.setRenderHint(QPainter::Antialiasing);
+  p.setPen(Qt::NoPen);
+  p.setBrush(st.secondary);
+  p.drawEllipse(QRectF(4, 4, 56, 56));
+  mobile::PaintIcon(p, "close", QRectF(18, 18, 28, 28), st.dark ? QColor(0x1c, 0x1c, 0x1e) : Qt::white);
+  return QIcon(pm);
+}
