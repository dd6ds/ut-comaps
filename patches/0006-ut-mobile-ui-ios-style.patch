+void RoundButton::paintEvent(QPaintEvent *)
+{
+  Style const & st = CurrentStyle();
+  QPainter p(this);
+  p.setRenderHint(QPainter::Antialiasing);
+  QRectF const r = QRectF(rect()).adjusted(1, 1, -1, -1);
+  if (!m_flat)
+  {
+    p.setPen(Qt::NoPen);
+    p.setBrush(QColor(0, 0, 0, st.dark ? 90 : 45));
+    p.drawEllipse(r.translated(0, 1.2));
+    p.setBrush(isDown() ? st.panelPressed : st.panel);
+    p.drawEllipse(r.adjusted(0, 0, 0, -0.6));
+  }
+  else if (isDown())
+  {
+    p.setPen(Qt::NoPen);
+    p.setBrush(st.panelPressed);
+    p.drawEllipse(r);
+  }
+  else
+  {
+    p.setPen(Qt::NoPen);
+    p.setBrush(st.field);
+    p.drawEllipse(r);
+  }
+  double const icon = m_diameter * (m_flat ? 0.5 : 0.46);
+  QRectF const ir(r.center().x() - icon / 2, r.center().y() - icon / 2, icon, icon);
+  QColor c = m_iconColor.isValid() ? m_iconColor : st.text;
+  if (!isEnabled())
+    c = st.secondary;
+  PaintIcon(p, m_icon, ir, c);
+}
