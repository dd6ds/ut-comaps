+Card::Card(QWidget * parent, bool topOnly) : QWidget(parent), m_topOnly(topOnly) {}
+
+void Card::paintEvent(QPaintEvent *)
+{
+  Style const & st = CurrentStyle();
+  QPainter p(this);
+  p.setRenderHint(QPainter::Antialiasing);
+  p.setPen(Qt::NoPen);
+  double const radius = 16;
+  QRectF const r(rect());
+  QPainterPath path;
+  if (m_topOnly)
+  {
+    path.moveTo(r.left(), r.bottom() + 1);
+    path.lineTo(r.left(), r.top() + radius);
+    path.arcTo(QRectF(r.left(), r.top(), 2 * radius, 2 * radius), 180, -90);
+    path.lineTo(r.right() - radius, r.top());
+    path.arcTo(QRectF(r.right() - 2 * radius, r.top(), 2 * radius, 2 * radius), 90, -90);
+    path.lineTo(r.right(), r.bottom() + 1);
+    path.closeSubpath();
+  }
+  else
+  {
+    path.addRoundedRect(r.adjusted(0.5, 0.5, -0.5, -0.5), radius, radius);
+  }
+  QColor bg = st.panel;
+  bg.setAlpha(255);
+  p.setBrush(bg);
+  p.drawPath(path);
+}
