+// Small images for the stylesheet (it can only reference files).
+QString UiImage(QString const & name, std::function<void(QPainter &)> const & paint)
+{
+  static QString const dir = QDir::tempPath() + QString("/ut-comaps-ui-%1/").arg(QCoreApplication::applicationPid());
+  QDir().mkpath(dir);
+  QString const path = dir + name + ".png";
+  if (!QFileInfo::exists(path))
+  {
+    QImage img(48, 48, QImage::Format_ARGB32_Premultiplied);
+    img.fill(Qt::transparent);
+    QPainter p(&img);
+    p.setRenderHint(QPainter::Antialiasing);
+    paint(p);
+    p.end();
+    img.save(path);
+  }
+  return path;
