+    return;
+  m_routePrimary->setText(primary);
+  m_routeSecondary->setText(secondary);
+  m_routeSecondary->setVisible(!secondary.isEmpty());
+  m_routeStart->setVisible(!error);
+  // Always tappable: without the own position as start, tapping explains
+  // that and offers to route from there (like the iPhone app).
