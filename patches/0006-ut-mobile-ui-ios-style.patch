+void MapUi::BuildLayers()
+{
+  m_layersCard = new Card(this);
+  m_layersCard->setObjectName("utLayersCard");
+  auto * v = new QVBoxLayout(m_layersCard);
+  v->setContentsMargins(4, 8, 4, 8);
+  v->setSpacing(0);
+
+  struct Layer
+  {
+    char const * objectName;
+    char const * icon;
+    QString text;
+  };
+  Layer const layers[] = {
+      {"utLayerOutdoor", "mountain", Tr("Outdoor", "Outdoor")},
+      {"utLayerContours", "contour", Tr("Contour lines", "Höhenlinien")},
+      {"utLayer3d", "cube", Tr("3D buildings", "3D-Gebäude")},
+      {"utLayerTransit", "publictransport", Tr("Transit lines", "ÖPNV-Linien")},
+  };
+  for (size_t i = 0; i < std::size(layers); ++i)
+  {
+    auto * row = new RowButton(layers[i].icon, layers[i].text, m_layersCard);
+    row->setObjectName(layers[i].objectName);
+    row->setCheckable(true);
+    v->addWidget(row);
+    m_layerRows.push_back(row);
+    connect(row, &QAbstractButton::clicked, this, [this, i](bool on)
+    {
+      Framework & fw = GetFramework();
+      switch (i)
+      {
+      case 0: fw.SetOutdoorLayer(on); break;
+      case 1: fw.SetContourLinesLayer(on); break;
+      case 2: fw.SetBuildings3d(on); break;
+      case 3: fw.PublicTransportMapModeSetTransitLines(on); break;
+      }
+      m_map->update();
+    });
+  }
+  m_layersCard->hide();
+}
+
+void MapUi::UpdateLayerChecks()
+{
+  if (m_layerRows.size() < 4)
+    return;
+  Framework & fw = GetFramework();
+  bool const values[] = {fw.HasOutdoorLayer(), fw.HasContourLinesLayer(), fw.HasBuildings3d(),
+                         fw.PublicTransportMapModeHasTransitLines()};
+  for (size_t i = 0; i < 4; ++i)
+  {
+    QSignalBlocker block(m_layerRows[i]);
+    m_layerRows[i]->setChecked(values[i]);
+  }
+}
