+void MainWindow::SetupMobileUi()
+{
+  if (m_screenshotMode || !m_mobileUi)
+    return;
+
+  // The desktop controls do not fit a phone; the floating controls replace them.
+  menuBar()->hide();
+  if (m_navToolBar)
+    m_navToolBar->hide();
+  m_downloadButton->hide();
+  m_retryButton->hide();
+  m_cancelDownloadButton->hide();
+
+  mobile::MapUi::Actions a;
+  a.setMapMode = [this](MapMode mode) { SetMapMode(mode); };
+  a.myPosition = [this] { m_pDrawWidget->GetFramework().SwitchMyPositionNextMode(); };
+#ifndef NO_DOWNLOADER
+  a.showDownloader = [this] { ShowUpdateDialog(); };
+#endif
+  a.showBookmarks = [this] { OnBookmarksAction(); };
+  a.showPreferences = [this] { OnPreferences(); };
+  a.showRoutingSettings = [this] { OnRoutingSettings(); };
+  a.showAbout = [this] { OnAbout(); };
+  a.osmLogin = [this] { OnLoginMenuItem(); };
+  a.createFeature = [this]
+  {
+    // Like the desktop button: the map center becomes the new place.
+    m_pDrawWidget->CreateFeature();
+  };
+  a.ruler = [this](bool on)
+  {
+    m_rulerAction->setChecked(on);
+    m_pDrawWidget->SetRuler(on);
+  };
+  a.download = [this] { OnDownloadClicked(); };
+  a.retryDownload = [this] { OnRetryDownloadClicked(); };
+  a.cancelDownload = [this] { OnCancelDownloadClicked(); };
+  a.followRoute = [this]
+  {
+    if (m_pDrawWidget->CanFollowRoute())
+    {
+      OnFollowRoute();
+      return;
+    }
+    QMessageBox box(this);
+    box.setWindowTitle(mobile::Tr("Navigation", "Navigation"));
+    box.setText(mobile::Tr("Navigation can only start at your current position.\n\n"
+                           "Calculate the route from your position to the destination?",
+                           "Die Navigation kann nur am aktuellen Standort starten.\n\n"
+                           "Route von deinem Standort zum Ziel berechnen?"));
+    QAbstractButton * fromHere =
+        box.addButton(mobile::Tr("From my position", "Ab meinem Standort"), QMessageBox::AcceptRole);
+    box.addButton(mobile::Tr("Cancel", "Abbrechen"), QMessageBox::RejectRole);
+    box.exec();
+    if (box.clickedButton() != fromHere)
+      return;
+    if (!m_pDrawWidget->RouteFromMyPosition())
+    {
+      QMessageBox::information(this, mobile::Tr("Navigation", "Navigation"),
+                               mobile::Tr("Your position is not known yet. Turn on location and wait for a GPS fix.",
+                                          "Dein Standort ist noch nicht bekannt. Bitte Standortdienste einschalten "
+                                          "und auf ein GPS-Signal warten."));
+    }
+  };
+  a.clearRoute = [this] { OnClearRoute(); };
+  m_mobileUi->Init(std::move(a));
+
+  DrawWidget::MobileSinks sinks;
+  sinks.showPlace = [this](place_page::Info const & info, search::ReverseGeocoder::Address const & address)
+  { m_mobileUi->ShowPlace(info, address); };
+  sinks.hidePlace = [this] { m_mobileUi->HidePlace(); };
+  sinks.showRoute = [this](QString const & primary, QString const & secondary, bool error, bool canStart)
+  { m_mobileUi->ShowRoute(primary, secondary, error, canStart); };
+  sinks.hideRoute = [this] { m_mobileUi->HideRoute(); };
+  m_pDrawWidget->SetMobileSinks(std::move(sinks));
+
+  // UI tests on the phone (only with UT_COMAPS_TEST set): "center <lat> <lon> [zoom]".
+  ut_test::RegisterCommand("center", [this](QStringList const & args)
+  {
+    GetFramework().SetViewportCenter(mercator::FromLatLon(args.value(0).toDouble(), args.value(1).toDouble()),
+                                     args.value(2, "12").toInt(), false /* isAnim */);
+  });
+  ut_test::RegisterCommand("search", [this](QStringList const & args)
+  {
+    m_mobileUi->OpenSearch();
+    Q_UNUSED(args);
+  });
+}
+
+void MainWindow::ForwardCountryStatus()
+{
+  if (!m_mobileUi || m_screenshotMode)
+    return;
+  using State = mobile::MapUi::CountryState;
+  State state = State::None;
+  QString text;
+  QString const name = m_lastCountry.empty()
+                           ? QString()
+                           : QString::fromStdString(GetFramework().GetStorage().GetNodeLocalName(m_lastCountry));
+  if (m_downloadButton->isVisible() || m_downloadButton->isVisibleTo(this))
+  {
+    state = State::Download;
+    std::string units;
+    size_t size = 0;
+    FormatMapSize(GetFramework().GetStorage().CountrySizeInBytes(m_lastCountry).second, units, size);
+    text = mobile::Tr("Download %1 (%2 %3)", "%1 herunterladen (%2 %3)").arg(name).arg(size).arg(units.c_str());
+  }
+  else if (m_cancelDownloadButton->isVisibleTo(this))
+  {
+    state = State::Downloading;
+    text = mobile::Tr("Downloading %1 …", "%1 wird geladen …").arg(name);
+  }
+  else if (m_retryButton->isVisibleTo(this))
+  {
+    state = State::Retry;
+    text = mobile::Tr("Retry download of %1", "%1 erneut herunterladen").arg(name);
+  }
+  m_downloadButton->hide();
+  m_retryButton->hide();
+  m_cancelDownloadButton->hide();
+  m_mobileUi->SetCountryState(state, text);
+}
