--- /dev/null
+++ b/qt/ut_test_hook.cpp
@@ -0,0 +1,361 @@
+// ut-comaps: remote control for UI tests on the phone.
+//
+// Only active when UT_COMAPS_TEST is set to a file path. Commands written to
+// that file (one per line) are executed in order, e.g. from adb:
+//   echo "click utMenuButton" >> $UT_COMAPS_TEST
+// Commands: click <objectName> | clicktext <text> | tap <x> <y> | drag <x1> <y1> <x2> <y2>
+//           type <text> | key <qt key code> | back | dump | shot [file.png] | sleep <ms>
+//           | <registered command> ...
+// Coordinates are logical pixels in the active window. "dump" writes the visible
+// widgets with their geometry to <file>.out.
+#include "qt/ut_test_hook.hpp"
+
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QPointer>
+#include <QtCore/QTextStream>
+#include <QtCore/QTimer>
+#include <QtGui/QKeyEvent>
+#include <QtGui/QMouseEvent>
+#include <QtGui/QPixmap>
+#include <QtWidgets/QAbstractButton>
+#include <QtWidgets/QApplication>
+#include <QtWidgets/QDialog>
+#include <QtWidgets/QLabel>
+#include <QtWidgets/QLineEdit>
+#include <QtWidgets/QListWidget>
+#include <QtWidgets/QWidget>
+
+#include <map>
+
+namespace ut_test
+{
+namespace
+{
+std::map<QString, Command> & Registry()
+{
+  static std::map<QString, Command> registry;
+  return registry;
+}
+
+QWidget * ActiveWindow()
+{
+  if (QWidget * w = QApplication::activePopupWidget())
+    return w;
+  if (QWidget * w = QApplication::activeModalWidget())
+    return w;
+  if (QWidget * w = QApplication::activeWindow())
+    return w;
+  QWidget * best = nullptr;
+  for (QWidget * w : QApplication::topLevelWidgets())
+    if (w->isVisible() && (!best || w->width() * w->height() > best->width() * best->height()))
+      best = w;
+  return best;
+}
+
+QWidget * FindByName(QString const & name)
+{
+  // Prefer widgets in the active (modal) window.
+  QWidget * window = ActiveWindow();
+  if (window)
+  {
+    if (window->objectName() == name)
+      return window;
+    for (QWidget * w : window->findChildren<QWidget *>(name))
+      if (w->isVisible())
+        return w;
+  }
+  for (QWidget * w : QApplication::allWidgets())
+    if (w->objectName() == name && w->isVisible())
+      return w;
+  return nullptr;
+}
+
+void SendClick(QWidget * target, QPointF const & local, int holdMs = 60)
+{
+  QPointer<QWidget> w(target);
+  QPointF const scene = target->mapTo(target->window(), local.toPoint());
+  QPointF const global = target->mapToGlobal(local.toPoint());
+  QMouseEvent press(QEvent::MouseButtonPress, local, scene, global, Qt::LeftButton, Qt::LeftButton, Qt::NoModifier);
+  QApplication::sendEvent(target, &press);
+  QTimer::singleShot(holdMs, [w, local, scene, global]
+  {
+    if (!w)
+      return;
+    QMouseEvent release(QEvent::MouseButtonRelease, local, scene, global, Qt::LeftButton, Qt::NoButton,
+                        Qt::NoModifier);
+    QApplication::sendEvent(w, &release);
+  });
+}
+
+void Dump(QWidget * w, QTextStream & out, int depth)
+{
+  if (!w->isVisible())
+    return;
+  QRect const g(w->mapTo(w->window(), QPoint(0, 0)), w->size());
+  QString text;
+  if (auto * b = qobject_cast<QAbstractButton *>(w))
+    text = b->text();
+  else if (auto * l = qobject_cast<QLabel *>(w))
+    text = l->text().left(60);
+  else if (auto * e = qobject_cast<QLineEdit *>(w))
+    text = e->text();
+  out << QString(depth * 2, ' ') << w->metaObject()->className() << " '" << w->objectName() << "' " << g.x() << ","
+      << g.y() << " " << g.width() << "x" << g.height();
+  if (!text.isEmpty())
+    out << " \"" << text.simplified() << "\"";
+  out << "\n";
+  for (QObject * child : w->children())
+    if (child->isWidgetType())
+      Dump(static_cast<QWidget *>(child), out, depth + 1);
+}
+
+class Hook : public QObject
+{
+public:
+  explicit Hook(QString path) : QObject(qApp), m_path(std::move(path))
+  {
+    connect(&m_timer, &QTimer::timeout, this, [this] { Poll(); });
+    m_timer.start(150);
+  }
+
+private:
+  void Poll()
+  {
+    if (m_busyUntilNextTick)
+      return;
+    if (m_queue.isEmpty())
+    {
+      QFile f(m_path);
+      if (f.size() <= 0 || !f.open(QIODevice::ReadWrite))
+        return;
+      QString const all = QString::fromUtf8(f.readAll());
+      f.resize(0);
+      f.close();
+      for (QString const & line : all.split('\n', Qt::SkipEmptyParts))
+        m_queue << line.trimmed();
+    }
+    if (m_queue.isEmpty())
+      return;
+    QString const cmd = m_queue.takeFirst();
+    Log("> " + cmd);
+    Run(cmd);
+  }
+
+  void Log(QString const & line)
+  {
+    QFile f(m_path + ".out");
+    if (f.open(QIODevice::Append))
+      f.write((line + "\n").toUtf8());
+  }
+
+  void Pause(int ms)
+  {
+    m_busyUntilNextTick = true;
+    QTimer::singleShot(ms, this, [this] { m_busyUntilNextTick = false; });
+  }
+
+  void Run(QString const & cmd)
+  {
+    QStringList const args = cmd.split(' ', Qt::SkipEmptyParts);
+    if (args.isEmpty())
+      return;
+    QString const & op = args[0];
+    QString const rest = cmd.section(' ', 1);
+
+    if (op == "sleep")
+    {
+      Pause(args.value(1).toInt());
+    }
+    else if (op == "click")
+    {
+      QWidget * w = FindByName(args.value(1));
+      if (!w)
+        return Log("not found: " + args.value(1));
+      QPointer<QWidget> pw(w);
+      // Deferred: the click may open a modal dialog (nested event loop).
+      QTimer::singleShot(0, [pw]
+      {
+        if (!pw)
+          return;
+        if (auto * b = qobject_cast<QAbstractButton *>(pw.data()))
+          b->click();
+        else
+          SendClick(pw, QPointF(pw->width() / 2.0, pw->height() / 2.0));
+      });
+    }
+    else if (op == "clicktext")
+    {
+      QWidget * window = ActiveWindow();
+      QList<QWidget *> candidates = window ? window->findChildren<QWidget *>() : QList<QWidget *>();
+      for (QWidget * w : QApplication::allWidgets())
+        candidates << w;
+      for (QWidget * w : candidates)
+      {
+        if (!w->isVisible())
+          continue;
+        if (auto * b = qobject_cast<QAbstractButton *>(w); b && b->text().contains(rest, Qt::CaseInsensitive))
+        {
+          QPointer<QAbstractButton> pb(b);
+          QTimer::singleShot(0, [pb] { if (pb) pb->click(); });
+          return;
+        }
+        if (auto * list = qobject_cast<QListWidget *>(w))
+        {
+          for (int i = 0; i < list->count(); ++i)
+          {
+            QListWidgetItem * item = list->item(i);
+            QString text = item->text() + " " + item->data(Qt::UserRole).toString();
+            if (QWidget * iw = list->itemWidget(item))
+              for (QLabel * l : iw->findChildren<QLabel *>())
+                text += " " + l->text();
+            if (text.contains(rest, Qt::CaseInsensitive))
+            {
+              QPointer<QListWidget> pl(list);
+              QTimer::singleShot(0, [pl, item] { if (pl) emit pl->itemClicked(item); });
+              return;
+            }
+          }
+        }
+      }
+      Log("text not found: " + rest);
+    }
+    else if (op == "tap" || op == "longtap")
+    {
+      QWidget * window = ActiveWindow();
+      if (!window)
+        return;
+      QPoint const p(args.value(1).toInt(), args.value(2).toInt());
+      QWidget * target = window->childAt(p);
+      if (!target)
+        target = window;
+      Log(QString("tap -> %1 '%2'").arg(target->metaObject()->className(), target->objectName()));
+      SendClick(target, target->mapFrom(window, p), op == "longtap" ? 1200 : 60);
+    }
+    else if (op == "drag")
+    {
+      QWidget * window = ActiveWindow();
+      if (!window)
+        return;
+      QPoint const a(args.value(1).toInt(), args.value(2).toInt());
+      QPoint const b(args.value(3).toInt(), args.value(4).toInt());
+      QWidget * target = window->childAt(a);
+      if (!target)
+        target = window;
+      QPointer<QWidget> pt(target);
+      auto const send = [pt, window](QEvent::Type type, QPoint wp, Qt::MouseButtons buttons)
+      {
+        if (!pt)
+          return;
+        QPointF const local = pt->mapFrom(window, wp);
+        QMouseEvent ev(type, local, QPointF(wp), pt->mapToGlobal(local.toPoint()), Qt::LeftButton, buttons,
+                       Qt::NoModifier);
+        QApplication::sendEvent(pt, &ev);
+      };
+      send(QEvent::MouseButtonPress, a, Qt::LeftButton);
+      int constexpr kSteps = 12;
+      for (int i = 1; i <= kSteps; ++i)
+      {
+        QPoint const p = a + (b - a) * i / kSteps;
+        QTimer::singleShot(i * 25, [send, p] { send(QEvent::MouseMove, p, Qt::LeftButton); });
+      }
+      QTimer::singleShot((kSteps + 1) * 25, [send, b] { send(QEvent::MouseButtonRelease, b, Qt::NoButton); });
+      Pause((kSteps + 4) * 25);
+    }
+    else if (op == "type")
+    {
+      if (auto * edit = qobject_cast<QLineEdit *>(QApplication::focusWidget()))
+        edit->insert(rest);
+      else if (QWidget * f = QApplication::focusWidget())
+      {
+        QKeyEvent press(QEvent::KeyPress, 0, Qt::NoModifier, rest);
+        QApplication::sendEvent(f, &press);
+      }
+      else
+        Log("no focus widget");
+    }
+    else if (op == "key")
+    {
+      if (QWidget * f = QApplication::focusWidget())
+      {
+        QKeyEvent press(QEvent::KeyPress, args.value(1).toInt(), Qt::NoModifier);
+        QApplication::sendEvent(f, &press);
+        QKeyEvent release(QEvent::KeyRelease, args.value(1).toInt(), Qt::NoModifier);
+        QApplication::sendEvent(f, &release);
+      }
+    }
+    else if (op == "back")
+    {
+      if (QWidget * popup = QApplication::activePopupWidget())
+        popup->close();
+      else if (auto * dlg = qobject_cast<QDialog *>(QApplication::activeModalWidget()))
+        QTimer::singleShot(0, dlg, [dlg] { dlg->reject(); });
+      else
+        Log("nothing to go back from");
+    }
+    else if (op == "shot")
+    {
+      // The app draws its active window into a PNG (works with the display off).
+      QWidget * window = ActiveWindow();
+      if (!window)
+        return Log("no window");
+      QString const file = args.value(1, m_path + ".png");
+      QPixmap const pm = window->grab();
+      Log(pm.save(file, "PNG") ? "saved " + file : "save failed " + file);
+    }
+    else if (op == "dump")
+    {
+      QFile f(m_path + ".out");
+      if (!f.open(QIODevice::Append))
+        return;
+      QTextStream out(&f);
+      for (QWidget * w : QApplication::topLevelWidgets())
+        if (w->isVisible())
+        {
+          out << "=== window " << w->metaObject()->className() << " '" << w->objectName() << "' "
+              << w->width() << "x" << w->height() << (w == ActiveWindow() ? " (active)" : "") << "\n";
+          Dump(w, out, 1);
+        }
+    }
+    else if (auto it = Registry().find(op); it != Registry().end())
+    {
+      it->second(args.mid(1));
+    }
+    else
+    {
+      Log("unknown command: " + op);
+    }
+  }
+
+  QString m_path;
+  QTimer m_timer;
+  QStringList m_queue;
+  bool m_busyUntilNextTick = false;
+};
+
+void InstallTestHook()
+{
+  QString const path = qEnvironmentVariable("UT_COMAPS_TEST");
+  if (path.isEmpty())
+    return;
+  // Created once the event loop runs (QApplication exists by then).
+  QTimer::singleShot(0, [path] { new Hook(path); });
+}
+}  // namespace
+
+void RegisterCommand(QString const & name, Command command)
+{
+  Registry()[name] = std::move(command);
+}
+
+bool Enabled()
+{
+  return qEnvironmentVariableIsSet("UT_COMAPS_TEST");
+}
+}  // namespace ut_test
+
+static void UtComapsInstallTestHook()
+{
+  ut_test::InstallTestHook();
+}
+Q_COREAPP_STARTUP_FUNCTION(UtComapsInstallTestHook)
