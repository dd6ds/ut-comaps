+
+QSize ModeSelector::sizeHint() const { return {4 * kModeCell + 8, kButton}; }
+
+void ModeSelector::paintEvent(QPaintEvent *)
+{
+  Style const & st = CurrentStyle();
+  QPainter p(this);
+  p.setRenderHint(QPainter::Antialiasing);
+  p.setPen(Qt::NoPen);
+  QRectF const r = QRectF(rect()).adjusted(1, 1, -1, -1);
+  p.setBrush(QColor(0, 0, 0, st.dark ? 90 : 45));
+  p.drawRoundedRect(r.translated(0, 1.2), r.height() / 2, r.height() / 2);
+  p.setBrush(st.panel);
+  p.drawRoundedRect(r.adjusted(0, 0, 0, -0.6), r.height() / 2, r.height() / 2);
+  for (int i = 0; i < 4; ++i)
+  {
+    QRectF const cell(4 + i * kModeCell, (height() - kModeCell) / 2.0, kModeCell, kModeCell);
+    if (kModes[i] == m_mode)
+    {
+      p.setPen(Qt::NoPen);
+      p.setBrush(st.selected);
+      p.drawEllipse(cell.adjusted(3, 3, -3, -3));
+    }
+    PaintIcon(p, kModeIcons[i], cell.adjusted(12, 12, -12, -12), st.text);
+  }
+}
+
+void ModeSelector::mousePressEvent(QMouseEvent * e) { e->accept(); }
+
+void ModeSelector::mouseReleaseEvent(QMouseEvent * e)
+{
+  int const i = static_cast<int>((e->position().x() - 4) / kModeCell);
+  if (i < 0 || i > 3 || !rect().contains(e->position().toPoint()))
+    return;
+  m_mode = kModes[i];
+  update();
+  if (m_onSelect)
+    m_onSelect(m_mode);
+}
