+bool DrawWidget::CanFollowRoute() const
+{
+  auto const points = m_framework.GetRoutingManager().GetRoutePoints();
+  return points.size() >= 2 && (points.front().m_isMyPosition || points.back().m_isMyPosition);
+}
+
+bool DrawWidget::RouteFromMyPosition()
+{
+  if (!m_framework.GetCurrentPosition())
+    return false;
+  auto & routingManager = m_framework.GetRoutingManager();
+  routingManager.RemoveRoutePoint(RouteMarkType::Start);
+  RouteMarkData start;
+  start.m_pointType = RouteMarkType::Start;
+  start.m_isMyPosition = true;
+  routingManager.AddRoutePoint(std::move(start));
+  if (routingManager.GetRoutePoints().size() >= 2)
+    routingManager.BuildRoute();
+  return true;
+}
+
+void DrawWidget::RouteFromCurrentPlace(RouteMarkType type)
+{
+  if (!m_framework.HasPlacePageInfo())
+    return;
+  m2::PointD const pt = m_framework.GetCurrentPlacePageInfo().GetMercator();
+  m_framework.DeactivateMapSelection();
+  SetRoutePointAddMode(type);
+  SubmitRoutingPoint(pt, true /* pointIsMercator */);
+}
+
+void DrawWidget::ToggleBookmarkForCurrentPlace()
+{
+  if (!m_framework.HasPlacePageInfo())
+    return;
+  place_page::Info const & info = m_framework.GetCurrentPlacePageInfo();
+  auto & manager = m_framework.GetBookmarkManager();
+  if (info.IsBookmark())
+  {
+    manager.GetEditSession().DeleteBookmark(info.GetBookmarkId());
+  }
+  else
+  {
+    kml::BookmarkData data;
+    data.m_color.m_predefinedColor = kml::PredefinedColor::Red;
+    data.m_point = info.GetMercator();
+    if (!info.GetTitle().empty())
+      kml::SetDefaultStr(data.m_name, info.GetTitle());
+    manager.GetEditSession().CreateBookmark(std::move(data), manager.LastEditedBMCategory());
+  }
+  m_framework.UpdatePlacePageInfoForCurrentSelection();
+  if (m_framework.HasPlacePageInfo())
+    ShowPlacePage();
+}
+
+void DrawWidget::EditCurrentPlace()
+{
+  if (!m_framework.HasPlacePageInfo())
+    return;
+  place_page::Info const & info = m_framework.GetCurrentPlacePageInfo();
+  osm::EditableMapObject emo;
+  if (!m_framework.GetEditableMapObject(info.GetID(), emo))
+  {
+    LOG(LERROR, ("Error while trying to edit feature."));
+    return;
+  }
+  FeatureID const id = info.GetID();
+  EditorDialog dlg(this, emo);
+  int const result = dlg.exec();
+  if (result == QDialog::Accepted)
+  {
+    m_framework.SaveEditedMapObject(emo);
+    m_framework.UpdatePlacePageInfoForCurrentSelection();
+  }
+  else if (result == QDialogButtonBox::DestructiveRole)
+  {
+    m_framework.DeleteFeature(id);
+  }
+}
+
+void DrawWidget::CloseCurrentPlace()
+{
+  m_framework.DeactivateMapSelection();
+  if (m_mobile.hidePlace)
+    m_mobile.hidePlace();
+}
