+// --- Layout --------------------------------------------------------------------------
+
+void MapUi::Relayout()
+{
+  int const w = width();
+  int const h = height();
+  m_map->setGeometry(0, 0, w, h);
+  if (!m_initialized)
+    return;
+
+  m_scrim->setGeometry(0, 0, w, h);
+
+  // Top row: menu, transport modes, layers.
+  m_menuButton->move(kMargin, kTop);
+  m_layersButton->move(w - kMargin - kButton, kTop);
+  m_modes->move((w - m_modes->width()) / 2, kTop);
+  // Too narrow for all three in a row: modes go below.
+  if (m_modes->width() > w - 2 * (kMargin + kButton + 8))
+    m_modes->move((w - m_modes->width()) / 2, kTop + kButton + 8);
+
+  int const cardWidth = std::min(330, w - 2 * kMargin);
+  m_menuCard->setFixedWidth(cardWidth);
+  m_menuCard->adjustSize();
+  m_menuCard->move(kMargin, kTop + kButton + 8);
+  int const layersWidth = std::min(270, w - 2 * kMargin);
+  m_layersCard->setFixedWidth(layersWidth);
+  m_layersCard->adjustSize();
+  m_layersCard->move(w - kMargin - layersWidth, kTop + kButton + 8);
+
+  bool const sheet = m_sheet != nullptr;
+  int bottomEdge = h - kBottom;  // everything below is taken by a sheet or card
+
+  if (sheet)
+  {
+    int const sh = SheetHeight() + kBottom;
+    m_sheet->setGeometry(0, h - sh, w, sh);
+    bottomEdge = h - sh - 10;
+  }
+
+  // The route card yields to the place page.
+  m_routeCard->setVisible(m_routeWanted && !sheet);
+  if (m_routeCard->isVisible())
+  {
+    int const rh = std::max(m_routeCard->sizeHint().height(), 72);
+    m_routeCard->setGeometry(kMargin, h - kBottom - rh, w - 2 * kMargin, rh);
+    bottomEdge = h - kBottom - rh - 10;
+  }
+
+  bool const bottomRow = !sheet && !m_routeCard->isVisible();
+  m_bookmarksButton->setVisible(bottomRow);
+  m_searchPill->setVisible(bottomRow);
+  int const rowY = bottomRow ? h - kBottom - kButton : bottomEdge - kButton;
+  m_bookmarksButton->move(kMargin, rowY);
+  int const pillX = kMargin + kButton + 10;
+  m_searchPill->setGeometry(pillX, rowY, w - 2 * pillX, kButton);
+  m_locationButton->move(w - kMargin - kButton, rowY);
+
+  // Map download banner above the bottom controls.
+  bool const country = m_countryState != CountryState::None && !sheet;
+  m_countryButton->setVisible(country);
+  if (country)
+  {
+    int const cw = std::min(m_countryButton->sizeHint().width(), w - 2 * kMargin);
+    m_countryButton->setGeometry((w - cw) / 2, rowY - 12 - 44, cw, 44);
+  }
+
+  if (m_searchPage && m_searchPage->isVisible())
+    m_searchPage->setGeometry(0, 0, w, h);
+
+  // Stacking: map, controls, scrim, cards, sheet, search page.
+  for (QWidget * wdg : {static_cast<QWidget *>(m_menuButton), static_cast<QWidget *>(m_modes),
+                        static_cast<QWidget *>(m_layersButton), static_cast<QWidget *>(m_bookmarksButton),
+                        static_cast<QWidget *>(m_searchPill), static_cast<QWidget *>(m_locationButton),
+                        static_cast<QWidget *>(m_countryButton), static_cast<QWidget *>(m_routeCard)})
+    wdg->raise();
+  if (m_scrim->isVisible())
+    m_scrim->raise();
+  if (m_menuCard->isVisible())
+    m_menuCard->raise();
+  if (m_layersCard->isVisible())
+    m_layersCard->raise();
+  if (m_sheet)
+    m_sheet->raise();
+  if (m_searchPage && m_searchPage->isVisible())
+    m_searchPage->raise();
+}
+}  // namespace mobile
+}  // namespace qt
