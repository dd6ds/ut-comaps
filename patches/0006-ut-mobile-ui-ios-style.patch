+// Full screen dialogs get a page header like the iPhone app: round back
+// button and the title (Lomiri shows no window titles).
+void AddPageHeader(QDialog * dlg)
+{
+  if (dlg->property("utHeader").toBool() || qobject_cast<QMessageBox *>(dlg))
+    return;
+  if (!(dlg->windowState() & (Qt::WindowMaximized | Qt::WindowFullScreen)))
+    return;
+  auto * box = qobject_cast<QBoxLayout *>(dlg->layout());
+  if (!box)
+    return;
+  dlg->setProperty("utHeader", true);
+  Style const & st = CurrentStyle();
+  auto * header = new QWidget(dlg);
+  header->setObjectName("utPageHeader");
+  auto * h = new QHBoxLayout(header);
+  h->setContentsMargins(0, 14, 0, 6);
+  h->setSpacing(8);
+  auto * back = new RoundButton("back", 40, header);
+  back->setObjectName("utPageBack");
+  back->SetFlat(true);
+  // A "Close" button is redundant next to the back button: hide it, but let
+  // back trigger it (some dialogs save on close).
+  QPointer<QAbstractButton> closeButton;
+  for (auto * b : dlg->findChildren<QPushButton *>())
+  {
+    QString const t = b->text().remove('&').trimmed();
+    if (t == "Close" || t == QString::fromUtf8("Schließen"))
+    {
+      closeButton = b;
+      b->hide();
+      break;
+    }
+  }
+  QObject::connect(back, &QAbstractButton::clicked, dlg, [dlg, closeButton]
+  {
+    if (closeButton)
+      closeButton->click();
+    else
+      dlg->reject();
+  });
+  h->addWidget(back);
+  QLabel * title = MakeLabel(dlg->windowTitle(), 19, st.text, true, header);
+  title->setObjectName("utPageTitle");
+  title->setAlignment(Qt::AlignCenter);
+  h->addWidget(title, 1);
+  h->addSpacing(40);
+  box->insertWidget(0, header);
+}
+
+// Every dialog that is shown gets finger scrolling in its lists.
+class DialogTouchFilter : public QObject
+{
+public:
+  using QObject::QObject;
+
+protected:
+  bool eventFilter(QObject * obj, QEvent * ev) override
+  {
+    if (ev->type() == QEvent::Show && obj->isWidgetType())
+    {
+      if (auto * dlg = qobject_cast<QDialog *>(obj))
+      {
+        QPointer<QDialog> pd(dlg);
+        QTimer::singleShot(0, dlg, [pd]
+        {
+          if (pd)
+            AddPageHeader(pd);
+        });
+        for (auto * area : dlg->findChildren<QAbstractScrollArea *>())
+        {
+          EnableFingerScrolling(area->viewport());
+          if (auto * view = qobject_cast<QAbstractItemView *>(area))
+          {
+            view->setVerticalScrollMode(QAbstractItemView::ScrollPerPixel);
+            view->setHorizontalScrollMode(QAbstractItemView::ScrollPerPixel);
+          }
+        }
+      }
+    }
+    return QObject::eventFilter(obj, ev);
+  }
+};
