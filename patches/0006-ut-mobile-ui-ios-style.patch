+void DrawWidget::resizeGL(int width, int height)
+{
+  TBase::resizeGL(width, height);
+  // ut-comaps phone UI: scale bar and copyright above the bottom buttons,
+  // compass below the layers button (like the iPhone app).
+  if (!m_mobile.showPlace || !m_skin || m_screenshotMode)
+    return;
+  double const r = m_ratio;
+  gui::TWidgetsLayoutInfo layout;
+  m_skin->ForEach([&layout](gui::EWidget w, gui::Position const & pos) { layout[w] = pos.m_pixelPivot; });
+  double const lift = (22 + 52 + 10) * r;
+  for (auto const w : {gui::WIDGET_RULER, gui::WIDGET_COPYRIGHT})
+    if (auto it = layout.find(w); it != layout.end())
+      it->second.y -= lift;
+  if (auto it = layout.find(gui::WIDGET_COMPASS); it != layout.end())
+    it->second = m2::PointD((width - 12 - 26) * r, (30 + 52 + 10 + 24) * r);
+  m_framework.SetWidgetLayout(std::move(layout));
+}
