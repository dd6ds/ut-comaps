+// Detail row of the place page: icon + (rich) text.
+QWidget * DetailRow(QString const & icon, QString const & html, bool links = false)
+{
+  Style const & st = CurrentStyle();
+  auto * row = new QWidget();
+  auto * h = new QHBoxLayout(row);
+  h->setContentsMargins(0, 10, 0, 10);
+  h->setSpacing(16);
+  auto * iv = new IconView(icon, 22);
+  iv->SetColor(st.secondary);
+  h->addWidget(iv, 0, Qt::AlignTop);
+  QLabel * label = MakeLabel(html, 16, st.text);
+  if (links)
+  {
+    label->setTextFormat(Qt::RichText);
+    label->setOpenExternalLinks(true);
+    label->setTextInteractionFlags(Qt::TextBrowserInteraction);
+  }
+  else
+  {
+    label->setTextInteractionFlags(Qt::TextSelectableByMouse);
+  }
+  h->addWidget(label, 1);
+  return row;
+}
