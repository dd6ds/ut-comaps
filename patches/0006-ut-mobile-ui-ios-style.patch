+
+void MapUi::ShowPlace(place_page::Info const & info, search::ReverseGeocoder::Address const & address)
+{
+  if (!m_initialized)
+    return;
+  CloseCards();
+  if (m_sheet)
+  {
+    m_sheet->hide();
+    m_sheet->deleteLater();
+    m_sheet = nullptr;
+  }
+  Style const & st = CurrentStyle();
+  Framework & fw = GetFramework();
+
+  m_sheet = new Card(this, true /* topOnly */);
+  m_sheet->setObjectName("utPlaceSheet");
+  auto * v = new QVBoxLayout(m_sheet);
+  v->setContentsMargins(18, 8, 14, 4);
+  v->setSpacing(4);
+
+  // Grabber.
+  auto * grabber = new QFrame(m_sheet);
+  grabber->setFixedSize(38, 5);
+  grabber->setStyleSheet(QString("background: %1; border-radius: 2px;").arg(Hex(st.separator)));
+  v->addWidget(grabber, 0, Qt::AlignHCenter);
+
+  // Header: title, type, distance, close.
+  {
+    auto * h = new QHBoxLayout();
+    h->setSpacing(8);
+    auto * left = new QVBoxLayout();
+    left->setSpacing(2);
+    QString title = QString::fromStdString(info.GetTitle());
+    QString subtitle = QString::fromStdString(info.GetSubtitle());
+    if (title.isEmpty())
+    {
+      title = subtitle.isEmpty() ? Tr("Selected point", "Ausgewählter Punkt") : subtitle;
+      subtitle.clear();
+    }
+    QLabel * titleLabel = MakeLabel(title, 24, st.text, true);
+    titleLabel->setObjectName("utPlaceTitle");
+    left->addWidget(titleLabel);
+    if (auto const secondary = info.GetSecondaryTitle(); !secondary.empty())
+      left->addWidget(MakeLabel(QString::fromStdString(secondary), 15, st.secondary));
+    if (!subtitle.isEmpty())
+      left->addWidget(MakeLabel(subtitle, 15, st.secondary));
+    h->addLayout(left, 1);
+
+    auto * right = new QVBoxLayout();
+    right->setSpacing(4);
+    auto * close = new RoundButton("close", 32);
+    close->setObjectName("utPlaceClose");
+    close->SetFlat(true);
+    connect(close, &QAbstractButton::clicked, this, [this] { m_map->CloseCurrentPlace(); });
+    right->addWidget(close, 0, Qt::AlignRight);
+    if (auto const pos = fw.GetCurrentPosition(); pos && !info.IsMyPosition())
+    {
+      auto const ll = mercator::ToLatLon(*pos);
+      platform::Distance dist;
+      double azimut = 0;
+      if (fw.GetDistanceAndAzimut(info.GetMercator(), ll.m_lat, ll.m_lon, -1.0, dist, azimut))
+      {
+        QLabel * d = MakeLabel(QString::fromStdString(dist.ToString()), 15, st.accent, true);
+        d->setWordWrap(false);
+        right->addWidget(d, 0, Qt::AlignRight);
+      }
+    }
+    right->addStretch(1);
+    h->addLayout(right);
+    v->addLayout(h);
+  }
+
+  // Details.
+  auto * content = new QWidget();
+  content->setObjectName("utPlaceDetails");
+  content->setStyleSheet("background: transparent;");
+  auto * cv = new QVBoxLayout(content);
+  cv->setContentsMargins(0, 0, 4, 0);
+  cv->setSpacing(0);
+  int rows = 0;
+  auto const addRow = [&](QString const & icon, QString const & html, bool links = false)
+  {
+    if (html.trimmed().isEmpty())
+      return;
+    if (rows++ > 0)
+    {
+      cv->addWidget(Separator());
+    }
+    cv->addWidget(DetailRow(icon, html, links));
+  };
+  using EType = feature::Metadata::EType;
+  auto const meta = [&info](EType t) { return QString::fromUtf8(info.GetMetadata(t).data(), info.GetMetadata(t).size()); };
+
+  if (auto const population = info.GetPopulation(); !population.empty())
+  {
+    bool ok = false;
+    qlonglong const n = QString::fromStdString(population).toLongLong(&ok);
+    QString const number = ok ? QLocale(IsGerman() ? QLocale::German : QLocale::English).toString(n)
+                              : QString::fromStdString(population);
+    addRow("people", Tr("%1 inhabitants", "%1 Einwohner").arg(number));
+  }
+  addRow("pin", QString::fromStdString(address.FormatAddress()));
+  if (auto const oh = info.GetOpeningHours(); !oh.empty())
+    addRow("clock", QString::fromUtf8(oh.data(), oh.size()));
+  addRow("cuisine", QString::fromStdString(info.FormatCuisines()));
+  if (auto const phone = meta(EType::FMD_PHONE_NUMBER); !phone.isEmpty())
+    addRow("phone", Link("tel:" + phone, phone), true);
+  if (auto const web = meta(EType::FMD_WEBSITE); !web.isEmpty())
+    addRow("globe", Link(web, web), true);
+  if (auto const mail = meta(EType::FMD_EMAIL); !mail.isEmpty())
+    addRow("mail", Link("mailto:" + mail, mail), true);
+  addRow("info", meta(EType::FMD_OPERATOR));
+  if (info.HasWifi())
+    addRow("wifi", Tr("Wi-Fi", "WLAN"));
+  if (auto const level = meta(EType::FMD_LEVEL); !level.isEmpty())
+    addRow("info", Tr("Level %1", "Etage %1").arg(level));
+  if (auto const & description = info.GetWikiDescription(); !description.empty())
+  {
+    QString text = QString::fromStdString(description);
+    text.remove(QRegularExpression("<[^>]*>"));
+    if (text.size() > 400)
+      text = text.left(397) + "…";
+    addRow("info", text);
+  }
+  {
+    ms::LatLon const ll = info.GetLatLon();
+    addRow("crosshair", QString("%1, %2").arg(ll.m_lat, 0, 'f', 6).arg(ll.m_lon, 0, 'f', 6));
+  }
+
+  m_sheetScroll = new QScrollArea(m_sheet);
+  m_sheetScroll->setObjectName("utPlaceScroll");
+  m_sheetScroll->setFrameShape(QFrame::NoFrame);
+  m_sheetScroll->setWidgetResizable(true);
+  m_sheetScroll->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+  m_sheetScroll->setStyleSheet("QScrollArea { background: transparent; }");
+  m_sheetScroll->viewport()->setAutoFillBackground(false);
+  m_sheetScroll->setWidget(content);
+  EnableFingerScrolling(m_sheetScroll->viewport());
+  m_sheetContent = content;
+  v->addWidget(Separator(m_sheet));
+  v->addWidget(m_sheetScroll, 1);
+  v->addWidget(Separator(m_sheet));
+
+  // Actions.
+  {
+    auto * h = new QHBoxLayout();
+    h->setSpacing(0);
+    h->setContentsMargins(0, 2, 0, 0);
+    auto const action = [&](char const * objectName, QString const & icon, QString const & text,
+                            std::function<void()> fn)
+    {
+      auto * b = new ActionButton(icon, text, m_sheet);
+      b->setObjectName(objectName);
+      connect(b, &QAbstractButton::clicked, this, [fn] { fn(); });
+      h->addWidget(b, 1);
+    };
+    action("utPlaceRouteFrom", "route_from", Tr("Route from", "Route von"),
+           [this] { m_map->RouteFromCurrentPlace(RouteMarkType::Start); });
+    bool const routing = !fw.GetRoutingManager().GetRoutePoints().empty();
+    if (routing)
+      action("utPlaceAddStop", "stop", Tr("Add stop", "Zwischenstopp"),
+             [this] { m_map->RouteFromCurrentPlace(RouteMarkType::Intermediate); });
+    bool const bookmarked = info.IsBookmark();
+    action("utPlaceBookmark", bookmarked ? "star" : "star_outline",
+           bookmarked ? Tr("Saved", "Gespeichert") : Tr("Save", "Speichern"),
+           [this] { m_map->ToggleBookmarkForCurrentPlace(); });
+    action("utPlaceRouteTo", "route_to", Tr("Route to", "Route nach"),
+           [this] { m_map->RouteFromCurrentPlace(RouteMarkType::Finish); });
+    if (info.ShouldShowEditPlace() && !routing)
+      action("utPlaceEdit", "edit", Tr("Edit", "Bearbeiten"), [this] { m_map->EditCurrentPlace(); });
+    v->addLayout(h);
+  }
+
+  m_sheet->show();
+  m_sheet->raise();
+  Relayout();
+}
