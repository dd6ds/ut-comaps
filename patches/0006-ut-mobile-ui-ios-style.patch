+void PaintGlyph(QPainter & p, ut_icons::Glyph const & g, QRectF const & r, QColor const & color)
+{
+  // Pad the glyph box a little, keep its aspect ratio, center it in r.
+  double const pad = std::max(g.w, g.h) * 0.04;
+  QRectF box(g.x - pad, g.y - pad, g.w + 2 * pad, g.h + 2 * pad);
+  QByteArray svg = QString("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"%1 %2 %3 %4\">"
+                           "<path fill=\"%5\" d=\"%6\"/></svg>")
+                       .arg(box.x()).arg(box.y()).arg(box.width()).arg(box.height())
+                       .arg(Hex(color), QString::fromLatin1(g.path))
+                       .toUtf8();
+  QSvgRenderer renderer(svg);
+  double const scale = std::min(r.width() / box.width(), r.height() / box.height());
+  QSizeF const size(box.width() * scale, box.height() * scale);
+  QRectF const target(r.center().x() - size.width() / 2, r.center().y() - size.height() / 2, size.width(),
+                      size.height());
+  renderer.render(&p, target);
+}
+
+QPainterPath StarPath(QPointF c, double outer, double inner)
+{
+  QPainterPath path;
+  for (int i = 0; i < 10; ++i)
+  {
+    double const a = -M_PI / 2 + i * M_PI / 5;
+    double const rad = (i % 2 == 0) ? outer : inner;
+    QPointF const pt(c.x() + rad * std::cos(a), c.y() + rad * std::sin(a));
+    if (i == 0)
+      path.moveTo(pt);
+    else
+      path.lineTo(pt);
+  }
+  path.closeSubpath();
+  return path;
+}
