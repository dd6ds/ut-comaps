+void MapUi::SetLocationMode(location::EMyPositionMode mode)
+{
+  if (!m_locationButton)
+    return;
+  Style const & st = CurrentStyle();
+  switch (mode)
+  {
+  case location::PendingPosition:
+    m_locationButton->SetIcon("location");
+    m_locationButton->SetIconColor(st.secondary);
+    break;
+  case location::NotFollowNoPosition:
+    m_locationButton->SetIcon("location");
+    m_locationButton->SetIconColor(st.text);
+    break;
+  case location::NotFollow:
+    m_locationButton->SetIcon("location");
+    m_locationButton->SetIconColor(st.locationBlue);
+    break;
+  case location::Follow:
+  case location::FollowAndRotate:
+    m_locationButton->SetIcon("location_fill");
+    m_locationButton->SetIconColor(st.locationBlue);
+    break;
+  }
