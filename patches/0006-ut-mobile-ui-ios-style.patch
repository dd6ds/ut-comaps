index 0000000..0d61835
--- /dev/null
+++ b/qt/ut_keep_display_on.cpp
@@ -0,0 +1,86 @@
+// ut-comaps: no screen dimming or locking while the app is in the foreground
+// (navigation, reading the map). Uses repowerd's Unity.Screen API, which the
+// "keep-display-on" AppArmor policy group allows. The request is dropped as
+// soon as the app goes to the background; repowerd also drops it when the app
+// quits or crashes (it belongs to our D-Bus connection).
+#include <QtCore/QCoreApplication>
+#include <QtCore/QTimer>
+#include <QtDBus/QDBusConnection>
+#include <QtDBus/QDBusMessage>
+#include <QtDBus/QDBusPendingCallWatcher>
+#include <QtDBus/QDBusPendingReply>
+#include <QtGui/QGuiApplication>
+
+namespace
+{
+char const * const kService = "com.canonical.Unity.Screen";
+char const * const kPath = "/com/canonical/Unity/Screen";
+char const * const kInterface = "com.canonical.Unity.Screen";
+
+class KeepDisplayOn : public QObject
+{
+public:
+  explicit KeepDisplayOn(QObject * parent) : QObject(parent)
+  {
+    connect(qGuiApp, &QGuiApplication::applicationStateChanged, this,
+            [this](Qt::ApplicationState state) { Update(state == Qt::ApplicationActive); });
+    Update(QGuiApplication::applicationState() == Qt::ApplicationActive);
+  }
+
+  ~KeepDisplayOn() override { Update(false); }
+
+private:
+  void Update(bool on)
+  {
+    QDBusConnection bus = QDBusConnection::systemBus();
+    if (!bus.isConnected())
+      return;
+    if (on && m_cookie < 0 && !m_pending)
+    {
+      m_pending = true;
+      auto const msg = QDBusMessage::createMethodCall(kService, kPath, kInterface, "keepDisplayOn");
+      auto * watcher = new QDBusPendingCallWatcher(bus.asyncCall(msg), this);
+      connect(watcher, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher * w)
+      {
+        QDBusPendingReply<int> const reply = *w;
+        w->deleteLater();
+        m_pending = false;
+        if (reply.isError())
+          return;
+        m_cookie = reply.value();
+        // Went to the background while the call was running.
+        if (QGuiApplication::applicationState() != Qt::ApplicationActive)
+          Update(false);
+      });
+    }
+    else if (!on && m_cookie >= 0)
+    {
+      auto msg = QDBusMessage::createMethodCall(kService, kPath, kInterface, "removeDisplayOnRequest");
+      msg << m_cookie;
+      bus.call(msg, QDBus::NoBlock);
+      m_cookie = -1;
+    }
+  }
+
+  int m_cookie = -1;
+  bool m_pending = false;
+};
+
+void Install()
+{
+  // Only on the phone (Lomiri sets APP_ID for click apps) and once the
+  // QGuiApplication exists.
+  if (!qEnvironmentVariableIsSet("APP_ID") || qEnvironmentVariableIsSet("UT_COMAPS_NO_KEEP_DISPLAY_ON"))
+    return;
+  QTimer::singleShot(0, [] {
+    if (qGuiApp)
+      new KeepDisplayOn(qGuiApp);
+  });
+}
+}  // namespace
+
+static void UtComapsInstallKeepDisplayOn()
+{
+  Install();
+}
+Q_COREAPP_STARTUP_FUNCTION(UtComapsInstallKeepDisplayOn)
