+
+int MapUi::SheetHeight() const
+{
+  if (!m_sheet || !m_sheetScroll || !m_sheetContent)
+    return 0;
+  // Heights for the real width: wrapped labels need it.
+  QLayout * sheetLayout = m_sheet->layout();
+  QMargins const m = sheetLayout->contentsMargins();
+  int const contentWidth = width() - m.left() - m.right();
+  QLayout * contentLayout = m_sheetContent->layout();
+  int const content = contentLayout->hasHeightForWidth() ? contentLayout->totalHeightForWidth(contentWidth - 4)
+                                                         : m_sheetContent->sizeHint().height();
+  // Everything but the details.
+  m_sheetScroll->setFixedHeight(0);
+  int const total = sheetLayout->hasHeightForWidth() ? sheetLayout->totalHeightForWidth(width())
+                                                     : sheetLayout->sizeHint().height();
+  int const fixed = total;
+  int const maxTotal = height() * 62 / 100;
+  int const scroll = std::max(0, std::min(content, maxTotal - fixed));
+  m_sheetScroll->setFixedHeight(scroll);
+  return fixed + scroll;
+}
