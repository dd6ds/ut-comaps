+// Ubuntu Touch: make CoMaps' desktop windows fit a phone screen.
+//
+// The CoMaps Qt frontend is written for desktops: dialogs use fixed start
+// sizes (e.g. resize(900, 600)) and layouts with large minimum sizes. On a
+// phone (1080x2400 at scale 2.625 = ~411x914 logical px) they run off screen.
+// This installs an application-wide event filter (no changes to the individual
+// dialogs needed): the main window and every large dialog are shown maximized
+// (= full available screen, the only placement Lomiri lets a client request).
+#include <QApplication>
+#include <QDebug>
+#include <QDialog>
+#include <QEvent>
+#include <QGuiApplication>
+#include <QLayout>
+#include <QMainWindow>
+#include <QScreen>
+#include <QTimer>
+#include <QWidget>
+
+#include <algorithm>
+
+namespace
+{
+class FitToScreenFilter : public QObject
+{
+public:
+  using QObject::QObject;
+
+protected:
+  bool eventFilter(QObject * obj, QEvent * ev) override
+  {
+    if (ev->type() == QEvent::Show && obj->isWidgetType())
+    {
+      auto * w = static_cast<QWidget *>(obj);
+      if (w->isWindow() && !IsTransient(w))
+        Fit(w);
+    }
+    return QObject::eventFilter(obj, ev);
+  }
+
+private:
+  static bool IsTransient(QWidget const * w)
+  {
+    auto const type = w->windowType();
+    return type == Qt::Popup || type == Qt::ToolTip || type == Qt::SplashScreen || type == Qt::Desktop;
+  }
+
+  static void Fit(QWidget * w)
+  {
+    QScreen * screen = w->screen() ? w->screen() : QGuiApplication::primaryScreen();
+    if (!screen)
+      return;
+    QRect const avail = screen->availableGeometry();
+
+    // The main window: let it fill the screen (Lomiri shows phone apps full screen).
+    if (qobject_cast<QMainWindow *>(w))
+    {
+      if (w->minimumWidth() > avail.width() || w->minimumHeight() > avail.height())
+        w->setMinimumSize(0, 0);
+      if (!(w->windowState() & (Qt::WindowMaximized | Qt::WindowFullScreen)))
+        w->setWindowState(w->windowState() | Qt::WindowMaximized);
+      return;
+    }
+
+    // Wayland: a client cannot position its own windows. Lomiri places dialogs
+    // offset from the main window (~85 x 250 logical px on a phone), so moving
+    // or merely shrinking them still leaves them partly off screen. What Lomiri
+    // does honour is the maximized state (tested on UT 24.04-2): the dialog then
+    // fills the screen below the indicator bar, like a mobile page.
+    // Small dialogs (message boxes, short prompts) are left alone.
+    bool const big = w->width() > avail.width() * 3 / 4 || w->height() > avail.height() * 3 / 5 ||
+                     w->minimumWidth() > avail.width() || w->minimumHeight() > avail.height();
+    if (!big)
+      return;
+
+    // A top-level layout forces its minimumSizeHint on the window; release it
+    // so the maximized window can be smaller than the desktop layout wanted.
+    if (QLayout * layout = w->layout())
+      layout->setSizeConstraint(QLayout::SetNoConstraint);
+    w->setMinimumSize(0, 0);
+    if (!(w->windowState() & (Qt::WindowMaximized | Qt::WindowFullScreen)))
+      w->setWindowState(w->windowState() | Qt::WindowMaximized);
+  }
+};
+
+void InstallFitToScreen()
+{
+  auto * app = QCoreApplication::instance();
+  app->installEventFilter(new FitToScreenFilter(app));
+
+  // Log the screen setup once the GUI is up (helps tuning ~/.config/ut-comaps/scale).
+  QTimer::singleShot(0, [] {
+    if (QScreen * s = QGuiApplication::primaryScreen())
+      qInfo() << "[ut] screen" << s->geometry() << "available" << s->availableGeometry()
+              << "devicePixelRatio" << s->devicePixelRatio() << "logicalDpi" << s->logicalDotsPerInch();
+  });
+}
+}  // namespace
+
+Q_COREAPP_STARTUP_FUNCTION(InstallFitToScreen)
